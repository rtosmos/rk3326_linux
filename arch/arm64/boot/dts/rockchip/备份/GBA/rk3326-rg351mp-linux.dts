		//05 20 01 01
		 
		05 78 01 28
		05 20 01 10 
			
			
			
		];
		display-timings {
			native-mode = <&timing0>;

			timing0: timing0 {
				/*
				clock-frequency = <85000000>;
				hactive = <1080>;
				vactive = <1200>;
				hfront-porch = <20>;
				hsync-len = <10>;
				hback-porch = <20>;
				vfront-porch = <8>;
				vsync-len = <4>;
				vback-porch = <8>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
				*/
				/*
			      //clock-frequency = <34653000>;
				clock-frequency = <35000000>;
				hactive = <720>;
				vactive = <720>;
